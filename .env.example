# ─────────────────────────────────────────────────────────────────────────────
# Bob Comic Studio — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bcs_user:bcs_password@localhost:5432/bob_comic_studio

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Get these from cloud.ibm.com → watsonx.ai → Projects
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set in frontend/.env.local for Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth (future) ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_32_char_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
